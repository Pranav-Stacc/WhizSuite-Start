{
  "name": "agency-os",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @agency-os/api dev",
    "dev:agent": "cd apps/agent && python -m uvicorn app.main:app --reload --port 8000",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:api-security": "node scripts/check-api-route-permissions.mjs",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @agency-os/api test:e2e && pnpm --filter @agency-os/web test:e2e",
    "test:e2e:api": "pnpm --filter @agency-os/api test:e2e",
    "test:e2e:web": "pnpm --filter @agency-os/web test:e2e",
    "db:generate": "pnpm --filter @agency-os/api db:generate",
    "db:migrate": "pnpm --filter @agency-os/api db:migrate",
    "db:push": "pnpm --filter @agency-os/api db:push",
    "db:seed": "pnpm --filter @agency-os/api db:seed",
    "db:studio": "pnpm --filter @agency-os/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
