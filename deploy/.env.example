# Production settings for deploy/docker-compose.prod.yml (copy to deploy/.env on the server; never commit).

# --- Compose ---
API_IMAGE_REPO=<account>.dkr.ecr.<region>.amazonaws.com/whizsuite-api
API_DOMAIN=api.whizsuite.praanav.in
POSTGRES_USER=whizsuite
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=whizsuite

# --- API (validated by apps/api/src/shared/config/app.config.ts) ---
NODE_ENV=production
PORT=3001
API_PREFIX=api
DATABASE_URL=postgresql://whizsuite:<password>@postgres:5432/whizsuite?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=<generate, min 32 chars>
JWT_REFRESH_SECRET=<generate, min 32 chars>
COOKIE_SECURE=true
COOKIE_DOMAIN=api.whizsuite.praanav.in
CORS_ORIGINS=https://whizsuite.com,https://www.whizsuite.com,https://*.whizsuite.com,https://whizsuite.praanav.in,https://www.whizsuite.praanav.in,https://*.whizsuite.praanav.in
WEB_APP_URL=https://whizsuite.com
# Meta Instagram / Facebook Login (must match Valid OAuth Redirect URIs in Meta portal)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.whizsuite.praanav.in/api/platforms/callback
META_GRAPH_API_VERSION=v21.0
PORTAL_ACCESS_LINK_TTL_HOURS=720
PORTAL_ACCESS_TEMP_MEMBERSHIP_HOURS=168
MOBILE_APP_STORE_URL=
MOBILE_PLAY_STORE_URL=
STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com
STORAGE_BUCKET=<bucket>
STORAGE_REGION=<region>
STORAGE_FORCE_PATH_STYLE=false
EMAIL_PROVIDER=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
