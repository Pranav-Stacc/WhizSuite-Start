# Server-only settings (never exposed to the browser)
# demo = built-in in-memory data (works with no backend); live = talk to apps/api
# Portal links, invitations, and Playwright e2e require live + API_BASE_URL reachable from this process.
APP_DATA_MODE=demo
API_BASE_URL=http://localhost:3001/api
SESSION_COOKIE_SECURE=false
# Server-side API call logs (method, URL, status, duration, error body, exception): off | errors | all
API_DEBUG_LOG=errors
API_DEBUG_BODY_MAX_CHARS=2000
# Agency subdomains: {slug}.whizsuite.com, crm-{slug}.whizsuite.com, finance-{slug}.whizsuite.com
# Leave empty for single-host local mode (CRM/Finance switch via cookie).
APP_ROOT_DOMAIN=
# Shared session across subdomains, e.g. .whizsuite.com (required for SSO between CRM/Finance/main)
SESSION_COOKIE_DOMAIN=

# Public, intentionally browser-visible
NEXT_PUBLIC_APP_NAME=WhizSuite
NEXT_PUBLIC_APP_ROOT_DOMAIN=
# Web OAuth client ID from Firebase / Google Cloud Console (Google Identity Services).
# Optional in live mode: login/register fetch GET /v1/auth/oauth-config when this is empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=9465040813-c2o7a0t2b86tqnareuods7evo5ge355v.apps.googleusercontent.com
# Firebase web app + Cloud Messaging (project whizsuite-759b0)
# VAPID key: Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=whizsuite-759b0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=whizsuite-759b0
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=whizsuite-759b0.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=9465040813
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
