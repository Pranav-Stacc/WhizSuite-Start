# frozen_string_literal: true

default_platform(:ios)

def app_store_api_key
  key_path = ENV.fetch("APPSTORE_CONNECT_KEY_FILE")
  app_store_connect_api_key(
    key_id: ENV.fetch("APPSTORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APPSTORE_CONNECT_ISSUER_ID"),
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

def sync_signing(readonly:)
  api_key = app_store_api_key
  # On CI, setup_ci already created a temporary keychain — do not pass a
  # custom MATCH_KEYCHAIN_* name or Match looks for a keychain that does not exist.
  args = {
    type: "appstore",
    readonly: readonly,
    api_key: api_key,
    app_identifier: ENV.fetch("APPLE_APP_IDENTIFIER", "com.whizsuite.app"),
    team_id: ENV.fetch("APPLE_TEAM_ID"),
    git_url: ENV.fetch("MATCH_GIT_URL"),
    git_branch: ENV.fetch("MATCH_GIT_BRANCH", "main"),
    generate_apple_certs: true
  }
  unless ENV["CI"]
    args[:keychain_name] = ENV["MATCH_KEYCHAIN_NAME"] if ENV["MATCH_KEYCHAIN_NAME"]
    args[:keychain_password] = ENV["MATCH_KEYCHAIN_PASSWORD"] if ENV["MATCH_KEYCHAIN_PASSWORD"]
  end
  match(args)
end

platform :ios do
  desc "Create or refresh App Store certs/profiles in the Match git repo (no personal Mac required — run on CI)"
  lane :certificates do
    setup_ci if ENV["CI"]
    sync_signing(readonly: false)
  end

  desc "Build signed IPA for App Store"
  lane :build do
    setup_ci if ENV["CI"]
    sync_signing(readonly: ENV["MATCH_READONLY"] != "false")

    app_id = ENV.fetch("APPLE_APP_IDENTIFIER", "com.whizsuite.app")
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][app_id]

    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      build_configurations: ["Release", "Profile"]
    )

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      output_name: "WhizSuite.ipa",
      clean: true,
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          app_id => profile_name
        }
      }
    )
  end

  desc "Upload IPA to TestFlight (manual release)"
  lane :beta do
    api_key = app_store_api_key
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/ipa/WhizSuite.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload IPA and submit for App Store review"
  lane :deploy do
    api_key = app_store_api_key
    upload_to_app_store(
      api_key: api_key,
      ipa: "build/ios/ipa/WhizSuite.ipa",
      force: true,
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end
end

platform :android do
  PACKAGE_NAME = "com.whizsuite.app"

  desc "Upload AAB + listing metadata to Play internal testing"
  lane :beta do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV.fetch("PLAY_STORE_JSON_KEY_FILE"),
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end

  desc "Upload AAB to Play production"
  lane :deploy do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      track: "production",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV.fetch("PLAY_STORE_JSON_KEY_FILE"),
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end
