NODE_ENV=development
PORT=3001
API_PREFIX=api

DATABASE_URL=postgresql://agency:agency_dev_password@localhost:5432/agency_os?schema=public

# On Windows, stop the legacy "Redis" Windows service (v3) or BullMQ will fail. Use Docker Redis 7 on 6379:
#   Stop-Service Redis
# Or map Docker to 6380 and set:
# REDIS_URL=redis://127.0.0.1:6380
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# Comma-separated browser origins allowed to call the API (credentials / cookies).
CORS_ORIGINS=http://localhost:3000,https://whizsuite.com,https://www.whizsuite.com
WEB_APP_URL=http://localhost:3000
INVITATION_TTL_HOURS=72
PORTAL_ACCESS_LINK_TTL_HOURS=720
PORTAL_ACCESS_TEMP_MEMBERSHIP_HOURS=168
MOBILE_APP_STORE_URL=
MOBILE_PLAY_STORE_URL=

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=agency-os
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_MAX_BYTES=104857600
STORAGE_ALLOWED_MIME_TYPES=image/*,video/*,audio/*,application/pdf
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_REQUEST_TIMEOUT_MS=10000
STORAGE_MAX_ATTEMPTS=3
MEDIA_LIST_LIMIT=200
CONTENT_LIST_LIMIT=500
CONTENT_MEDIA_MAX=20
CONTENT_HASHTAGS_MAX=30
CONTENT_REORDER_MAX=200
FEEDBACK_COMMENT_MAX_LENGTH=2000
FEEDBACK_COMMENT_LIST_LIMIT=500

EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=WhizSuite <noreply@whizsuite.com>
EMAIL_LOGO_URL=
AUTH_PASSWORD_RESET_TTL_HOURS=24
AUTH_EMAIL_VERIFY_TTL_HOURS=72

IDEMPOTENCY_TTL_SECONDS=86400
AUTHZ_CACHE_TTL_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_RELAY_ENABLED=true
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000

# Notifications (BullMQ requires Redis >= 5)
NOTIFICATION_LIST_LIMIT=50
NOTIFICATION_DEFAULT_CHANNELS=inApp,email,push
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_DELIVERY_ATTEMPTS=5
NOTIFICATION_DELIVERY_BACKOFF_MS=5000
NOTIFICATION_DELIVERY_CONCURRENCY=5
NOTIFICATION_DELIVERY_KEEP_FAILED=1000
NOTIFICATION_LINK_PATH=/notifications
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_POLL_MS=60000
REMINDER_SCHEDULER_BATCH=50
TASK_REMINDER_DUE_SOON_HOURS=24
APPROVAL_REMINDER_AFTER_HOURS=24
DEVICES_PER_USER_MAX=10

# Push via Firebase Cloud Messaging (HTTP v1); FCM_* are required when PUSH_ENABLED=true
# Project: whizsuite-759b0 — Android channel id must match mobile config PUSH_ANDROID_CHANNEL_ID
PUSH_ENABLED=false
PUSH_ANDROID_CHANNEL_ID=whizsuite_default
FCM_PROJECT_ID=whizsuite-759b0
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@whizsuite-759b0.iam.gserviceaccount.com
FCM_PRIVATE_KEY=

# Google Sign-In (ID token audiences = Web + native OAuth client IDs from Firebase / Google Cloud)
GOOGLE_AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_IDS=
# Google Drive + Calendar use OAuth 2.0 (Web application client), NOT a service-account JSON.
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Enable Google Drive API + Google Calendar API; add authorized redirect URIs below.
# Service accounts (e.g. FCM) are separate — see FCM_* above.
# Google Drive data source (Media → Storage). Redirect must match Google Cloud OAuth client.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-drive/callback
# Browser Picker API key (Google Cloud Console → Credentials → API key, restrict to Picker + Drive API).
GOOGLE_DRIVE_API_KEY=
# Optional Google Cloud project number for Picker appId.
GOOGLE_CLOUD_PROJECT_NUMBER=
# Google Calendar sync (Calendar page). Can reuse the same OAuth client with calendar scopes.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google-calendar/callback

# Meta Instagram / Facebook Login for Business (must match Valid OAuth Redirect URIs in Meta portal)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/platforms/callback
# From Meta App Dashboard → Facebook Login for Business → Configurations
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
RESOURCE_LIST_LIMIT=200
SEARCH_RESULT_LIMIT=20

# Local demo account (pnpm --filter api db:seed)
# Email: demo@whizsuite.com  Password: Demo123!
# Org slug: whizsuite-demo (18 clients, posts, shoots, tasks, team)
# Legacy mini org: owner@demo.agency / Demo123!

# LangGraph agent runtime (apps/agent)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TIMEOUT_MS=120000
AGENT_SCHEDULER_ENABLED=true
# LLM keys belong on the agent service (GEMINI_API_KEY), not in Nest.
