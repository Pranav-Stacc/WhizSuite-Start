NODE_ENV=development
PORT=3001
API_PREFIX=api

DATABASE_URL=postgresql://agency:agency_dev_password@localhost:5432/agency_os?schema=public

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=agency-os
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_MAX_BYTES=104857600
STORAGE_ALLOWED_MIME_TYPES=image/*,video/*,audio/*,application/pdf
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_REQUEST_TIMEOUT_MS=10000
STORAGE_MAX_ATTEMPTS=3
MEDIA_LIST_LIMIT=200

EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

IDEMPOTENCY_TTL_SECONDS=86400
AUTHZ_CACHE_TTL_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_RELAY_ENABLED=true
