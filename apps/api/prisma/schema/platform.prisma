// customization, templates, calendar, activity, integrations, analytics, reporting, time, knowledge

model CustomFieldDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  key            String
  label          String
  type           String
  options        Json?
  isRequired     Boolean  @default(false) @map("is_required")
  isFilterable   Boolean  @default(false) @map("is_filterable")
  clientVisible  Boolean  @default(false) @map("client_visible")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, entityType, key])
  @@map("custom_field_definitions")
  @@schema("customization")
}

model Form {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  status         String   @default("DRAFT")
  definition     Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submissions FormSubmission[]

  @@index([organizationId])
  @@map("forms")
  @@schema("customization")
}

model FormSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  payload        Json
  submittedById  String?  @map("submitted_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, formId])
  @@map("form_submissions")
  @@schema("customization")
}

model Template {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  type           String
  name           String
  scope          String   @default("ORGANIZATION")
  definition     Json
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, type])
  @@map("templates")
  @@schema("templates")
}

model CalendarItem {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  sourceType         String    @map("source_type")
  sourceId           String    @map("source_id") @db.Uuid
  title              String
  startsAt           DateTime  @map("starts_at") @db.Timestamptz
  endsAt             DateTime? @map("ends_at") @db.Timestamptz
  allDay             Boolean   @default(false) @map("all_day")
  clientId           String?   @map("client_id") @db.Uuid
  projectId          String?   @map("project_id") @db.Uuid
  metadata           Json?
  /** User opted this event into Google Calendar sync. */
  syncToGoogle       Boolean   @default(false) @map("sync_to_google")
  externalEventId    String?   @map("external_event_id")
  externalCalendarId String?   @map("external_calendar_id")

  @@index([organizationId, startsAt])
  @@index([organizationId, clientId, startsAt])
  @@index([organizationId, projectId, startsAt])
  @@index([organizationId, syncToGoogle, startsAt])
  @@unique([organizationId, externalEventId])
  @@map("calendar_items")
  @@schema("calendar")
}

model Meeting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  title          String
  startsAt       DateTime @map("starts_at") @db.Timestamptz
  endsAt         DateTime @map("ends_at") @db.Timestamptz
  joinUrl        String?  @map("join_url")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, startsAt])
  @@map("meetings")
  @@schema("calendar")
}

/** Org-level Google Calendar link (credentials live on IntegrationConnection). */
model CalendarConnection {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  integrationConnectionId String    @unique @map("integration_connection_id") @db.Uuid
  externalCalendarId      String    @default("primary") @map("external_calendar_id")
  syncDirection           String    @default("OUT") @map("sync_direction")
  defaultSyncNewEvents    Boolean   @default(false) @map("default_sync_new_events")
  /** Which calendar source kinds may sync to Google when opted in (meetings, shoots, tasks, posts). */
  syncTypes               Json      @default("{\"meetings\":true,\"shoots\":true,\"tasks\":false,\"posts\":false}") @map("sync_types")
  lastSyncedAt            DateTime? @map("last_synced_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId])
  @@map("calendar_connections")
  @@schema("calendar")
}

model ActivityEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  verb           String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  summary        String
  visibility     String   @default("INTERNAL")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, entityType, entityId, createdAt])
  @@map("activity_events")
  @@schema("activity")
}

model IntegrationProvider {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  name        String
  category    String
  manifest    Json
  isActive    Boolean @default(true) @map("is_active")

  connections IntegrationConnection[]

  @@map("integration_providers")
  @@schema("integrations")
}

model IntegrationConnection {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  status         String   @default("CONNECTED")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  provider    IntegrationProvider @relation(fields: [providerId], references: [id])
  credentials IntegrationCredential?

  @@index([organizationId, providerId])
  @@map("integration_connections")
  @@schema("integrations")
}

model IntegrationCredential {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  connectionId   String   @unique @map("connection_id") @db.Uuid
  encryptedData  String   @map("encrypted_data")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
  @@schema("integrations")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  prefix         String
  keyHash        String    @map("key_hash")
  scopes         String[]
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, prefix])
  @@map("api_keys")
  @@schema("integrations")
}

model OutboundWebhook {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  url            String
  secretHash     String   @map("secret_hash")
  eventTypes     String[] @map("event_types")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("outbound_webhooks")
  @@schema("integrations")
}

model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  webhookId      String   @map("webhook_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  status         String
  attempts       Int      @default(0)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organizationId, webhookId, status])
  @@map("webhook_deliveries")
  @@schema("integrations")
}

model MetricDefinition {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  name        String
  formula     String?
  unit        String?
  platforms   String[]

  @@map("metric_definitions")
  @@schema("analytics")
}

model MetricSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  metricKey      String   @map("metric_key")
  channelId      String?  @map("channel_id") @db.Uuid
  contentVariantId String? @map("content_variant_id") @db.Uuid
  value          Decimal  @db.Decimal(18, 4)
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz

  @@index([organizationId, metricKey, recordedAt])
  @@map("metric_snapshots")
  @@schema("analytics")
}

model ReportTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  definition     Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  reports Report[]

  @@index([organizationId])
  @@map("report_templates")
  @@schema("reporting")
}

model Report {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  templateId     String?  @map("template_id") @db.Uuid
  title          String
  status         String   @default("DRAFT")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  snapshot       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  template ReportTemplate? @relation(fields: [templateId], references: [id])

  @@index([organizationId, clientId])
  @@map("reports")
  @@schema("reporting")
}

model TimeEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  taskId         String?  @map("task_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  description    String?
  minutes        Int
  billable       Boolean  @default(true)
  startedAt      DateTime @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, membershipId, startedAt])
  @@index([organizationId, membershipId, endedAt])
  @@map("time_entries")
  @@schema("time")
}

model Timesheet {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  weekStart      DateTime @map("week_start") @db.Date
  status         String   @default("DRAFT")
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz

  @@unique([organizationId, membershipId, weekStart])
  @@map("timesheets")
  @@schema("time")
}

model KbSpace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  visibility     String   @default("INTERNAL")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  pages KbPage[]

  @@index([organizationId])
  @@map("kb_spaces")
  @@schema("knowledge")
}

model KbPage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  spaceId        String   @map("space_id") @db.Uuid
  title          String
  content        Json
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  space KbSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, spaceId])
  @@map("kb_pages")
  @@schema("knowledge")
}
