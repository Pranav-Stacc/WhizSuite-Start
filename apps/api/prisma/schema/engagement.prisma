model InboxConversation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  channelId      String?   @map("channel_id") @db.Uuid
  type           String
  externalThreadId String? @map("external_thread_id")
  authorHandle   String?   @map("author_handle")
  status         String    @default("NEW")
  assigneeId     String?   @map("assignee_id") @db.Uuid
  priority       String    @default("NORMAL")
  sentiment      String?
  slaDueAt       DateTime? @map("sla_due_at") @db.Timestamptz
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  messages InboxMessage[]

  @@index([organizationId, clientId, status])
  @@map("inbox_conversations")
  @@schema("engagement")
}

model InboxMessage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  externalId     String?  @map("external_id")
  direction      String
  body           String
  authorType     String   @map("author_type")
  authorId       String?  @map("author_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, conversationId, createdAt])
  @@map("inbox_messages")
  @@schema("engagement")
}

model SavedReply {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  name           String
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, clientId])
  @@map("saved_replies")
  @@schema("engagement")
}

model SlaPolicy {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clientId       String? @map("client_id") @db.Uuid
  name           String
  firstResponseMinutes Int @map("first_response_minutes")
  businessHours  Json   @map("business_hours")

  @@index([organizationId])
  @@map("sla_policies")
  @@schema("engagement")
}
