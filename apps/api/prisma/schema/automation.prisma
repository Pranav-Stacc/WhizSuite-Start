model Automation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  versions AutomationVersion[]

  @@index([organizationId, status])
  @@map("automations")
  @@schema("automation")
}

model AutomationVersion {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  automationId   String    @map("automation_id") @db.Uuid
  version        Int
  trigger        Json
  conditions     Json?
  actions        Json
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runs       AutomationRun[]

  @@unique([automationId, version])
  @@map("automation_versions")
  @@schema("automation")
}

model AutomationRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  versionId      String    @map("version_id") @db.Uuid
  status         String    @default("QUEUED")
  triggerEventId String?   @map("trigger_event_id") @db.Uuid
  context        Json?
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  version AutomationVersion @relation(fields: [versionId], references: [id])
  steps   AutomationRunStep[]

  @@index([organizationId, status, createdAt])
  @@map("automation_runs")
  @@schema("automation")
}

model AutomationRunStep {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  stepKey        String   @map("step_key")
  status         String
  input          Json?
  output         Json?
  error          String?
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, runId])
  @@map("automation_run_steps")
  @@schema("automation")
}

model RecurrenceRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  rrule          String
  timezone       String
  actionType     String   @map("action_type")
  actionPayload  Json     @map("action_payload")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, isActive])
  @@map("recurrence_rules")
  @@schema("automation")
}
