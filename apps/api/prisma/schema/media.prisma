model MediaFolder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  path           String
  visibility     String   @default("INTERNAL")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  assets MediaAsset[]

  @@index([organizationId, path])
  @@map("media_folders")
  @@schema("media")
}

model MediaAsset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  folderId       String?   @map("folder_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  name           String
  mimeType       String    @map("mime_type")
  sizeBytes      BigInt    @map("size_bytes")
  currentVersion Int       @default(1) @map("current_version")
  status         String    @default("PROCESSING")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  folder   MediaFolder?      @relation(fields: [folderId], references: [id])
  versions MediaAssetVersion[]

  @@index([organizationId, clientId])
  @@map("media_assets")
  @@schema("media")
}

model MediaAssetVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  version        Int
  storageKey     String   @map("storage_key")
  checksum       String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  asset      MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  renditions MediaRendition[]

  @@unique([assetId, version])
  @@map("media_asset_versions")
  @@schema("media")
}

model MediaRendition {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  versionId      String @map("version_id") @db.Uuid
  type           String
  storageKey     String @map("storage_key")
  width          Int?
  height         Int?

  version MediaAssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([organizationId, versionId])
  @@map("media_renditions")
  @@schema("media")
}

model MediaShareLink {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  passwordHash   String?   @map("password_hash")
  allowDownload  Boolean   @default(false) @map("allow_download")
  maxViews       Int?      @map("max_views")
  viewCount      Int       @default(0) @map("view_count")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, assetId])
  @@map("media_share_links")
  @@schema("media")
}
